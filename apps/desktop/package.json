{
  "name": "@openrisksim/desktop",
  "productName": "OpenRiskSim",
  "version": "0.2.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "OpenRiskSim desktop app: Monte Carlo risk simulation, forecasting and optimization for spreadsheets.",
  "author": "Fernando Daza (https://github.com/fernandevdaza)",
  "homepage": "https://fernandevdaza.github.io/openrisksim/",
  "main": "electron/main.cjs",
  "scripts": {
    "copy-web": "node scripts/copy-web.mjs",
    "start": "pnpm --filter @openrisksim/web build && node scripts/copy-web.mjs && electron .",
    "dev": "VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dist": "pnpm --filter @openrisksim/web build && node scripts/copy-web.mjs && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.fernandevdaza.openrisksim",
    "productName": "OpenRiskSim",
    "copyright": "Copyright © 2026 Fernando Daza y colaboradores · GPL-3.0-or-later",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "OpenRiskSim ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OpenRiskSim",
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "synopsis": "Monte Carlo risk simulation for spreadsheets",
      "maintainer": "Fernando Daza <fernandevdaza@users.noreply.github.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "executableName": "openrisksim",
      "desktop": {
        "entry": {
          "Name": "OpenRiskSim",
          "StartupWMClass": "OpenRiskSim"
        }
      }
    },
    "publish": {
      "provider": "github",
      "owner": "fernandevdaza",
      "repo": "openrisksim",
      "releaseType": "draft"
    }
  },
  "desktopName": "openrisksim.desktop"
}
