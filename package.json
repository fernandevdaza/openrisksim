{
  "name": "openrisksim",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source Monte Carlo risk simulation, forecasting and optimization for spreadsheets (an alternative to Risk Simulator / @RISK / Crystal Ball).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @openrisksim/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "docs:dev": "pnpm --filter @openrisksim/docs dev",
    "docs:build": "pnpm --filter @openrisksim/docs build",
    "screenshots": "pnpm --filter @openrisksim/web build && node scripts/screenshots.mjs",
    "build:site": "pnpm --filter @openrisksim/web build && pnpm --filter @openrisksim/docs build && rm -rf apps/web/dist/docs && cp -r docs/.vitepress/dist apps/web/dist/docs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fernandevdaza/openrisksim.git"
  },
  "homepage": "https://fernandevdaza.github.io/openrisksim/",
  "bugs": {
    "url": "https://github.com/fernandevdaza/openrisksim/issues"
  },
  "author": "Fernando Daza",
  "keywords": [
    "monte-carlo",
    "risk-analysis",
    "simulation",
    "spreadsheet",
    "xlsx",
    "project-evaluation",
    "npv",
    "irr",
    "forecasting",
    "optimization"
  ]
}
